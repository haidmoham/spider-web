<mujoco model="spider">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom contype="1" conaffinity="1" friction="1 0.5 0.5" density="500" rgba="0.01 0.01 0.015 1"/>
  </default>

  <worldbody>
    <light name="main" pos="0 0 2" dir="0 0 -1"/>
    <geom name="ground" type="plane" size="12 12 0.1" rgba="0.91 0.925 0.945 1"/>

    <body name="torso" pos="0 0 0.38">
      <freejoint name="root"/>
      <geom name="torso_geom" type="box" size="0.22 0.16 0.07" rgba="0.01 0.01 0.015 1"/>
      <site name="torso_center" pos="0 0 0" size="0.02" rgba="1 0 0 1"/>

      <body name="front_left" pos="0.14 0.11 0" euler="0 55 38">
        <joint name="front_left_hip" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="front_left_thigh" type="capsule" fromto="0 0 0 0.26 0 0" size="0.035"/>
        <body name="front_left_shin" pos="0.26 0 0">
          <joint name="front_left_knee" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom name="front_left_shin_geom" type="capsule" fromto="0 0 0 0.24 0 0" size="0.03"/>
          <geom name="front_left_foot" type="sphere" pos="0.24 0 0" size="0.045" rgba="0.85 0.02 0.03 1"/>
          <site name="front_left_contact_site" pos="0.24 0 0" size="0.02"/>
        </body>
      </body>

      <body name="front_right" pos="0.14 -0.11 0" euler="0 55 -38">
        <joint name="front_right_hip" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="front_right_thigh" type="capsule" fromto="0 0 0 0.26 0 0" size="0.035"/>
        <body name="front_right_shin" pos="0.26 0 0">
          <joint name="front_right_knee" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom name="front_right_shin_geom" type="capsule" fromto="0 0 0 0.24 0 0" size="0.03"/>
          <geom name="front_right_foot" type="sphere" pos="0.24 0 0" size="0.045" rgba="0.85 0.02 0.03 1"/>
          <site name="front_right_contact_site" pos="0.24 0 0" size="0.02"/>
        </body>
      </body>

      <body name="middle_left" pos="0 0.16 0" euler="0 55 90">
        <joint name="middle_left_hip" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="middle_left_thigh" type="capsule" fromto="0 0 0 0.26 0 0" size="0.035"/>
        <body name="middle_left_shin" pos="0.26 0 0">
          <joint name="middle_left_knee" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom name="middle_left_shin_geom" type="capsule" fromto="0 0 0 0.24 0 0" size="0.03"/>
          <geom name="middle_left_foot" type="sphere" pos="0.24 0 0" size="0.045" rgba="0.85 0.02 0.03 1"/>
          <site name="middle_left_contact_site" pos="0.24 0 0" size="0.02"/>
        </body>
      </body>

      <body name="middle_right" pos="0 -0.16 0" euler="0 55 -90">
        <joint name="middle_right_hip" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="middle_right_thigh" type="capsule" fromto="0 0 0 0.26 0 0" size="0.035"/>
        <body name="middle_right_shin" pos="0.26 0 0">
          <joint name="middle_right_knee" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom name="middle_right_shin_geom" type="capsule" fromto="0 0 0 0.24 0 0" size="0.03"/>
          <geom name="middle_right_foot" type="sphere" pos="0.24 0 0" size="0.045" rgba="0.85 0.02 0.03 1"/>
          <site name="middle_right_contact_site" pos="0.24 0 0" size="0.02"/>
        </body>
      </body>

      <body name="rear_left" pos="-0.14 0.11 0" euler="0 55 142">
        <joint name="rear_left_hip" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="rear_left_thigh" type="capsule" fromto="0 0 0 0.26 0 0" size="0.035"/>
        <body name="rear_left_shin" pos="0.26 0 0">
          <joint name="rear_left_knee" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom name="rear_left_shin_geom" type="capsule" fromto="0 0 0 0.24 0 0" size="0.03"/>
          <geom name="rear_left_foot" type="sphere" pos="0.24 0 0" size="0.045" rgba="0.85 0.02 0.03 1"/>
          <site name="rear_left_contact_site" pos="0.24 0 0" size="0.02"/>
        </body>
      </body>

      <body name="rear_right" pos="-0.14 -0.11 0" euler="0 55 -142">
        <joint name="rear_right_hip" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="rear_right_thigh" type="capsule" fromto="0 0 0 0.26 0 0" size="0.035"/>
        <body name="rear_right_shin" pos="0.26 0 0">
          <joint name="rear_right_knee" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom name="rear_right_shin_geom" type="capsule" fromto="0 0 0 0.24 0 0" size="0.03"/>
          <geom name="rear_right_foot" type="sphere" pos="0.24 0 0" size="0.045" rgba="0.85 0.02 0.03 1"/>
          <site name="rear_right_contact_site" pos="0.24 0 0" size="0.02"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="front_left_hip_motor" joint="front_left_hip" kp="100" ctrlrange="-0.8 0.8"/>
    <position name="front_left_knee_motor" joint="front_left_knee" kp="100" ctrlrange="-1.4 1.4"/>
    <position name="front_right_hip_motor" joint="front_right_hip" kp="100" ctrlrange="-0.8 0.8"/>
    <position name="front_right_knee_motor" joint="front_right_knee" kp="100" ctrlrange="-1.4 1.4"/>
    <position name="middle_left_hip_motor" joint="middle_left_hip" kp="100" ctrlrange="-0.8 0.8"/>
    <position name="middle_left_knee_motor" joint="middle_left_knee" kp="100" ctrlrange="-1.4 1.4"/>
    <position name="middle_right_hip_motor" joint="middle_right_hip" kp="100" ctrlrange="-0.8 0.8"/>
    <position name="middle_right_knee_motor" joint="middle_right_knee" kp="100" ctrlrange="-1.4 1.4"/>
    <position name="rear_left_hip_motor" joint="rear_left_hip" kp="100" ctrlrange="-0.8 0.8"/>
    <position name="rear_left_knee_motor" joint="rear_left_knee" kp="100" ctrlrange="-1.4 1.4"/>
    <position name="rear_right_hip_motor" joint="rear_right_hip" kp="100" ctrlrange="-0.8 0.8"/>
    <position name="rear_right_knee_motor" joint="rear_right_knee" kp="100" ctrlrange="-1.4 1.4"/>
  </actuator>

  <sensor>
    <framequat name="torso_orientation" objtype="body" objname="torso"/>
    <framelinvel name="torso_velocity" objtype="body" objname="torso"/>
    <touch name="front_left_contact" site="front_left_contact_site"/>
    <touch name="front_right_contact" site="front_right_contact_site"/>
    <touch name="middle_left_contact" site="middle_left_contact_site"/>
    <touch name="middle_right_contact" site="middle_right_contact_site"/>
    <touch name="rear_left_contact" site="rear_left_contact_site"/>
    <touch name="rear_right_contact" site="rear_right_contact_site"/>
  </sensor>
</mujoco>
